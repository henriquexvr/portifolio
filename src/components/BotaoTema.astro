---
<div id="btn-tema" class="btn" role="switch" aria-checked="false" aria-label="Alternar tema entre papel e blueprint" title="Alternar para blueprint" data-bloco="tema">
  <span class="label-papel">PAPEL</span>
  <span class="separador">/</span>
  <span class="label-blueprint">BLUEPRINT</span>
</div>

<style>
  #btn-tema {
    position: fixed;
    top: calc(var(--recuo-moldura) + 12px);
    right: calc(var(--recuo-moldura) + 12px);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    z-index: 1000;
  }
  #btn-tema[aria-checked="false"] .label-papel { background: var(--ink); color: var(--paper); }
  #btn-tema[aria-checked="false"] .label-blueprint { background: transparent; color: var(--ink); }
  #btn-tema[aria-checked="true"] .label-papel { background: transparent; color: var(--ink); }
  #btn-tema[aria-checked="true"] .label-blueprint { background: var(--ink); color: var(--paper); }
  .separador { color: var(--muted); font-size: 11px; }
  @media (max-width: 900px) {
    #btn-tema { top: 12px; right: 12px; min-width: 44px; min-height: 44px; justify-content: center; }
    .label-papel, .label-blueprint, .separador { display: none; }
    #btn-tema::before { content: "☀"; }
    #btn-tema[aria-checked="true"]::before { content: "☾"; }
  }
</style>

<script>
  const btn = document.getElementById('btn-tema');
  const update = () => {
    const isDark = document.documentElement.getAttribute('data-tema') === 'escuro';
    btn.setAttribute('aria-checked', isDark);
    btn.title = isDark ? 'Alternar para papel' : 'Alternar para blueprint';
    btn.setAttribute('aria-label', isDark ? 'Alternar para papel' : 'Alternar para blueprint');
  };
  btn.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-tema') === 'claro' ? 'escuro' : 'claro';
    document.documentElement.setAttribute('data-tema', next);
    localStorage.setItem('tema', next);
    update();
  });
  update();
</script>