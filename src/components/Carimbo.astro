<div class="carimbo" id="carimbo" data-bloco="carimbo">
  <div class="grid-carimbo">
    <div class="celula"><small>PROJETO</small><br>Portfólio pessoal</div>
    <div class="celula"><small>PÁGINA</small><br><span id="pag-num">01</span> / 03</div>
    <div class="celula"><small>SEÇÃO</small><br><span id="pag-secao">CAPA</span></div>
    <div class="celula"><small>REV.</small><br>A</div>
    <div class="celula"><small>AUTOR</small><br>Henrique Xavier</div>
    <div class="celula"><small>DATA</small><br>10/2026</div>
  </div>
  <nav class="nav-botoes" aria-label="Navegação entre páginas">
    <button class="btn" data-hash="#capa" aria-current="true" title="Ir para 01 · Capa" aria-label="Ir para 01 · Capa">01</button>
    <button class="btn" data-hash="#cuphub" title="Ir para 02 · CupHub" aria-label="Ir para 02 · CupHub">02</button>
    <button class="btn" data-hash="#automacao" title="Ir para 03 · Automação" aria-label="Ir para 03 · Automação">03</button>
    <button class="btn" id="btn-anterior" title="Página anterior" aria-label="Página anterior">↑</button>
    <button class="btn" id="btn-proximo" title="Próxima página" aria-label="Próxima página">↓</button>
  </nav>
</div>

<script>
  const updateActive = (hash, idx) => {
    document.querySelectorAll('.nav-botoes button[data-hash]').forEach(btn => {
      btn.setAttribute('aria-current', btn.dataset.hash === hash ? 'true' : 'false');
    });
    // disable anterior/proximo
    const ant = document.getElementById('btn-anterior');
    const prox = document.getElementById('btn-proximo');
    if (ant) ant.disabled = idx === 0;
    if (prox) prox.disabled = idx === 2;
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const pag = entry.target;
        const idx = pag.id === 'capa' ? 0 : pag.id === 'cuphub' ? 1 : 2;
        document.getElementById('pag-num').textContent = String(idx + 1).padStart(2, '0');
        document.getElementById('pag-secao').textContent = pag.dataset.titulo;
        const hash = '#' + pag.id;
        history.replaceState(null, null, hash);
        updateActive(hash, idx);
      }
    });
  }, { threshold: 0.6 });

  document.querySelectorAll('.pagina').forEach(p => observer.observe(p));

  // ResizeObserver para altura real do carimbo
  const carimboEl = document.getElementById('carimbo');
  if (carimboEl) {
    const ro = new ResizeObserver(entries => {
      for (let entry of entries) {
        const h = entry.contentRect.height;
        document.querySelectorAll('.proj-layout').forEach(pl => {
          pl.style.setProperty('--carimbo-h', h + 'px');
        });
      }
    });
    ro.observe(carimboEl);
  }
  document.querySelectorAll('.nav-botoes button[data-hash]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelector(btn.dataset.hash).scrollIntoView({ behavior: 'smooth' });
    });
  });
  document.getElementById('btn-anterior').addEventListener('click', () => window.scrollBy(0, -window.innerHeight));
  document.getElementById('btn-proximo').addEventListener('click', () => window.scrollBy(0, window.innerHeight));
</script>

<style>
  .carimbo {
    position: fixed;
    bottom: calc(var(--recuo-moldura) + var(--folga) + 4px);
    right: calc(var(--recuo-moldura) + var(--folga) + 4px);
    width: 340px;
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    padding: 12px;
    z-index: 1000;
  }
  .grid-carimbo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .celula { border-bottom: 0.5px solid var(--ink); padding-bottom: 4px; }
  .celula small { font-size: 10px; color: var(--muted); text-transform: uppercase; }
  .nav-botoes { display: flex; gap: 4px; margin-top: 8px; }
  .btn { min-width: 30px; min-height: 30px; padding: 4px 8px; }
  @media (max-width: 900px) {
    .carimbo { bottom: 0; right: 0; width: 100%; border-left: none; border-right: none; border-bottom: none; }
    .grid-carimbo { display: none; }
    .nav-botoes { width: 100%; justify-content: space-between; }
    .btn { min-width: 44px; min-height: 44px; }
  }
</style>