<div class="carimbo" id="carimbo" data-bloco="carimbo">
  <div class="grid-carimbo">
    <div class="celula"><small>PROJETO</small><br>Portfólio pessoal</div>
    <div class="celula"><small>PÁGINA</small><br><span id="pag-num">01</span> / 03</div>
    <div class="celula"><small>SEÇÃO</small><br><span id="pag-secao">CAPA</span></div>
    <div class="celula"><small>REV.</small><br>A</div>
    <div class="celula"><small>AUTOR</small><br>Henrique Xavier</div>
    <div class="celula"><small>DATA</small><br>10/2026</div>
  </div>
  <nav class="nav-botoes" aria-label="Navegação entre páginas">
    <button data-hash="#capa" aria-current="page">01</button>
    <button data-hash="#cuphub">02</button>
    <button data-hash="#automacao">03</button>
    <button onclick="window.scrollBy(0, -window.innerHeight)" aria-label="Anterior">↑</button>
    <button onclick="window.scrollBy(0, window.innerHeight)" aria-label="Próxima">↓</button>
  </nav>
</div>

<script>
  const updateActive = (hash) => {
    document.querySelectorAll('.nav-botoes button[data-hash]').forEach(btn => {
      btn.setAttribute('aria-current', btn.dataset.hash === hash ? 'page' : 'false');
    });
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const pag = entry.target;
        document.getElementById('pag-num').textContent = 
          pag.id === 'capa' ? '01' : pag.id === 'cuphub' ? '02' : '03';
        document.getElementById('pag-secao').textContent = pag.dataset.titulo;
        const hash = '#' + pag.id;
        history.replaceState(null, null, hash);
        updateActive(hash);
      }
    });
  }, { threshold: 0.6 });

  document.querySelectorAll('.pagina').forEach(p => observer.observe(p));
  document.querySelectorAll('.nav-botoes button[data-hash]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelector(btn.dataset.hash).scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>

<style>
  .carimbo {
    position: fixed;
    bottom: calc(var(--recuo-moldura) + 12px);
    right: calc(var(--recuo-moldura) + 12px);
    width: 340px;
    background: var(--paper);
    border: 1px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    padding: 12px;
    z-index: 1000;
  }
  .grid-carimbo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .celula { border-bottom: 0.5px solid var(--ink); padding-bottom: 4px; }
  .celula small { font-size: 10px; color: var(--muted); text-transform: uppercase; }
  .nav-botoes { display: flex; gap: 4px; margin-top: 8px; }
  button { padding: 4px 8px; border: 1px solid var(--ink); background: var(--paper); cursor: pointer; min-width: 30px; min-height: 30px; }
  button[aria-current="page"] { background: var(--ink); color: var(--paper); }
  @media (max-width: 900px) {
    .carimbo { bottom: 0; right: 0; width: 100%; border-left: none; border-right: none; border-bottom: none; }
    .grid-carimbo { display: none; }
  }
</style>