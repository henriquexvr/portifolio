---
interface Props {
  projeto: any;
  proximo?: string;
  idx: number;
}
const { projeto, proximo, idx } = Astro.props;
const num = String(idx + 1).padStart(2, '0');
---
<section class="pagina" id={projeto.slug} data-titulo={projeto.titulo.toUpperCase()}>
  <div class="moldura-interna">
    <header class="header-proj">
      <a href="#capa">← CAPA</a>
      <h1>{num} · {projeto.titulo.toUpperCase()}</h1>
      {projeto.subtitulo && <p class="subtitulo">{projeto.subtitulo} · {projeto.ano}</p>}
    </header>

    <div class="conteudo-grid">
      <div class="bloco">
        <h2>01 VISÃO GERAL</h2>
        <p>{projeto.visao || <span class="vazio">visão geral: a definir</span>}</p>
      </div>

      <div class="bloco">
        <h2>02 ARQUITETURA</h2>
        <div class="diag-container">
           <slot name="diagrama" />
           <p class="legenda">Diagrama simplificado</p>
        </div>
      </div>

      <div class="bloco">
        <h2>03 STACK</h2>
        <div class="stack-tags">
          {projeto.stack.map(s => <span>{s}</span>)}
        </div>
      </div>

      <div class="bloco">
        <h2>04 DESTAQUES TÉCNICOS</h2>
        <ul>{projeto.destaques.map(d => <li>{d}</li>)}</ul>
      </div>

      <div class="bloco">
        <h2>05 PAPEL</h2>
        <p>{projeto.papel}</p>
      </div>

      <div class="bloco">
        <h2>06 REPOSITÓRIO</h2>
        {projeto.repositorio ? 
          <a href={projeto.repositorio} target="_blank" rel="noopener noreferrer">{projeto.repositorio.replace('https://', '')} ↗</a>
          : <span class="vazio">repositório: a definir</span>
        }
      </div>
    </div>

    {proximo && (
      <footer class="footer-proj">
        <a href={`#${proximo.slug}`}>→ PRÓXIMO: {proximo.titulo.toUpperCase()}</a>
      </footer>
    )}
  </div>
</section>

<style>
  .pagina { height: 100dvh; height: 100vh; scroll-snap-align: start; scroll-snap-stop: always; overflow: hidden; padding: 40px; position: relative; }
  .moldura-interna { width: 100%; height: 100%; border: 0.5px solid var(--ink); padding: 24px; display: flex; flex-direction: column; gap: 16px; }
  .header-proj a { text-decoration: none; border-bottom: 1px solid var(--ink); display: inline-block; margin-bottom: 8px; }
  h1 { font-family: 'Zilla Slab', serif; font-size: 3rem; margin: 0; }
  .conteudo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; overflow-y: auto; }
  .bloco { border-top: 1px solid var(--ink); padding-top: 8px; }
  h2 { font-size: 11px; color: var(--muted); margin: 0 0 8px 0; }
  .stack-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .stack-tags span { border: 1px solid var(--ink); padding: 2px 8px; }
  .vazio { border: 1px dashed var(--muted); color: var(--muted); padding: 2px 4px; }
  .footer-proj { margin-top: auto; padding-top: 16px; text-align: right; }
  .footer-proj a { text-decoration: none; font-weight: 700; }
</style>