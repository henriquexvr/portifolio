---
import Folha from './Folha.astro';
interface Props {
  projeto: any;
  proximo?: string;
  idx: number;
}
const { projeto, proximo, idx } = Astro.props;
const num = String(idx + 1).padStart(2, '0');
const total = "02";
---
<Folha id={projeto.slug} titulo={projeto.titulo.toUpperCase()} dataBloco="moldura-interna">
  <div class="proj-layout" style="--carimbo-h: 236px;">
    <header class="header-proj">
      <a href="#capa" class="btn">← CAPA</a>
      <div class="proj-meta">PROJETO {num} / {total}</div>
      <h1>{projeto.titulo.toUpperCase()}</h1>
    </header>

    <div class="conteudo-grid" style="padding-bottom: calc(var(--carimbo-h) + 16px);">
      <div class="bloco">
        <h2>01 VISÃO GERAL</h2>
        <p>{projeto.visao || <span class="vazio">visão geral: a definir</span>}</p>
      </div>

      <div class="bloco">
        <h2>02 ARQUITETURA</h2>
        <div class="diag-container">
           <slot name="diagrama" />
           <p class="legenda">Diagrama simplificado</p>
        </div>
      </div>

      <div class="bloco">
        <h2>03 STACK</h2>
        <div class="stack-tags">
          {projeto.stack.map(s => <span>{s}</span>)}
        </div>
      </div>

      <div class="bloco">
        <h2>04 DESTAQUES TÉCNICOS</h2>
        <ul>{projeto.destaques.map(d => <li>{d}</li>)}</ul>
      </div>

      <div class="bloco">
        <h2>05 PAPEL</h2>
        <p>{projeto.papel}</p>
      </div>

      <div class="bloco">
        <h2>06 REPOSITÓRIO</h2>
        {projeto.repositorio ? 
          <a href={projeto.repositorio} class="btn" target="_blank" rel="noopener noreferrer" title="Ir para o repositório no GitHub" aria-label="Ir para o repositório no GitHub">{projeto.repositorio.replace('https://', '')} ↗</a>
          : <span class="vazio">repositório: a definir</span>
        }
      </div>
    </div>

      {proximo ? (
        <a href={`#${proximo.slug}`} class="btn" data-bloco="proximo" title={`Ir para ${proximo.titulo}`} aria-label={`Ir para ${proximo.titulo}`}>→ PRÓXIMO: {proximo.titulo.toUpperCase()}</a>
      ) : (
        <a href="#capa" class="btn" data-bloco="proximo" title="Voltar à capa" aria-label="Voltar à capa">↑ VOLTAR À CAPA</a>
      )}
    </div>
  </div>
</Folha>

<style>
  .proj-layout { display: flex; flex-direction: column; height: 100%; justify-content: space-between; gap: 12px; }
  .footer-proj { padding-bottom: calc(var(--carimbo-h, 236px) + 16px); }
  .proj-meta { font-size: 10px; color: var(--muted); text-transform: uppercase; margin-top: 4px; }
  h1 { font-family: 'Zilla Slab', serif; font-size: clamp(2.6rem, 3.6vw, 5rem); margin: 0; line-height: 1; }
  .conteudo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-content: start; }
  .bloco { border-top: 1px solid var(--ink); padding-top: 6px; }
  h2 { font-size: 11px; color: var(--muted); margin: 0 0 4px 0; }
  .stack-tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .stack-tags span { border: 1px solid var(--ink); padding: 2px 8px; }
  .vazio { border: 1px dashed var(--muted); color: var(--muted); padding: 2px 4px; }
  [data-bloco="proximo"] { display: inline-flex; width: auto; align-self: flex-start; }
  @media (max-width: 900px) {
    .conteudo-grid { grid-template-columns: 1fr; }
  }
</style>